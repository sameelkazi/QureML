# QureML Environment Configuration Template
# Copy this file to .env and configure your IBM Quantum credentials.

# IBM Quantum Runtime API Token (from https://quantum.ibm.com/)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# IBM Quantum Cloud Resource Name (CRN) instance (leave blank or default if using open instance)
IBM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/...

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
