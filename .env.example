# QureML Environment Configuration Template
# Copy this file to .env and configure your IBM Quantum credentials.

# IBM Quantum Runtime API Token (from https://quantum.ibm.com/)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# IBM Quantum Cloud Resource Name (CRN) instance (leave blank or default if using open instance)
IBM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/...

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# QureML AI Assistant API Keys (Supports 5-Key Round-Robin Rotation with Auto-Failover)
# Obtain free keys from Google AI Studio and configure either individually or comma-separated:
GEMINI_API_KEY_1=your_api_key_1_here
GEMINI_API_KEY_2=your_api_key_2_here
GEMINI_API_KEY_3=your_api_key_3_here
GEMINI_API_KEY_4=your_api_key_4_here
GEMINI_API_KEY_5=your_api_key_5_here
# Alternatively:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5

