<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>QureML — Overview</title>
<link rel="icon" href="data:,">
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
tailwind.config = {
  darkMode: "class",
  theme: { extend: {
    colors: {
      primary: "#006194", "primary-container": "#007bb9", "on-primary": "#ffffff", "on-primary-container": "#fdfcff",
      secondary: "#ba0035", "secondary-container": "#e21e49", "on-secondary": "#ffffff",
      background: "#f8f9ff", surface: "#f8f9ff", "surface-container-lowest": "#ffffff", "surface-container-low": "#eff4ff",
      "surface-container": "#e5eeff", "surface-container-high": "#dce9ff", "surface-container-highest": "#d3e4fe",
      "on-surface": "#0b1c30", "on-surface-variant": "#3f4850", outline: "#707881", "outline-variant": "#bfc7d2",
      tertiary: "#545c72", "inverse-primary": "#93ccff", "inverse-surface": "#213145", "inverse-on-surface": "#eaf1ff",
      success: "#0f7a3d", "success-container": "#e3f7ec"
    },
    borderRadius: { DEFAULT: "0.375rem", lg: "0.5rem", xl: "0.75rem", full: "999px" },
    fontFamily: { sans: ["Inter"], mono: ["JetBrains Mono"] }
  }}
}
</script>
<link rel="stylesheet" href="/shared.css"/>
</head>
<body class="bg-background text-on-surface font-sans antialiased min-h-screen flex flex-col">
<div id="site-nav"></div>
<main class="flex-1 max-w-[1400px] w-full mx-auto px-4 sm:px-8 py-8 space-y-8">

<section class="rounded-xl border border-outline-variant bg-surface-container-lowest p-6 sm:p-10 shadow-sm relative overflow-hidden">
<div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
<div class="relative z-10 space-y-5 max-w-4xl">
<div class="flex flex-wrap items-center gap-2">
<span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-semibold">SIH 2026 · Problem Statement SIH26139</span>
<span class="px-3 py-1 rounded-full bg-surface-container text-on-surface-variant text-xs border border-outline-variant">Sponsor: Egreen Quanta · SPIT Mumbai</span>
</div>
<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight">
A hybrid quantum-classical machine learning platform, benchmarked honestly against classical baselines.
</h1>
<p class="text-base text-on-surface-variant max-w-3xl">
A 6-qubit variational quantum classifier, parameter-matched against a classical MLP, evaluated across six real clinical datasets with rigorous statistics — plus genuine quantum-native engineering wins in efficiency, federation, and measurement-based uncertainty.
</p>
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-2">
<div class="p-4 rounded-lg bg-surface-container-low border border-outline-variant">
<div class="text-xs text-tertiary font-medium">DATASETS BENCHMARKED</div>
<div class="text-2xl font-bold text-primary mt-1">6</div>
<div class="text-xs text-on-surface-variant mt-1">Tabular + imaging, real clinical data</div>
</div>
<div class="p-4 rounded-lg bg-surface-container-low border border-outline-variant">
<div class="text-xs text-tertiary font-medium">ZERO-MISS SENSITIVITY</div>
<div class="text-2xl font-bold text-primary mt-1">100%</div>
<div class="text-xs text-on-surface-variant mt-1">τ=0.10, WDBC locked test set (n=57)</div>
</div>
<div class="p-4 rounded-lg bg-surface-container-low border border-outline-variant">
<div class="text-xs text-tertiary font-medium">CIRCUIT SIZE</div>
<div class="text-2xl font-bold text-primary mt-1">73 params</div>
<div class="text-xs text-on-surface-variant mt-1">6 qubits, 2 layers — parameter-matched vs classical</div>
</div>
<div class="p-4 rounded-lg bg-surface-container-low border border-outline-variant">
<div class="text-xs text-tertiary font-medium">VS. CLASSICAL BASELINE</div>
<div class="text-2xl font-bold text-on-surface mt-1">Parity</div>
<div class="text-xs text-on-surface-variant mt-1">No significant advantage after Holm-Bonferroni correction — stated honestly, not hidden</div>
</div>
</div>

<div id="ibm-hardware-widget" class="mt-4 p-4 rounded-xl border border-primary/25 bg-surface-container-low shadow-sm transition-all">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-outline-variant/60 pb-3">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
        <span class="material-symbols-outlined text-lg">memory</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-on-surface">IBM Quantum Hardware Telemetry</span>
          <span id="ibm-status-badge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-success-container text-success border border-success/30">
            <span class="w-1.5 h-1.5 rounded-full bg-success animate-ping"></span>
            <span id="ibm-status-text">LIVE TELEMETRY</span>
          </span>
        </div>
        <div class="text-xs text-tertiary">Real QPU calibration metrics from authenticated IBM Quantum Platform session</div>
      </div>
    </div>
    <a href="/architecture#ibm-hardware" class="text-xs font-semibold text-primary hover:text-primary-container flex items-center gap-1 transition-colors">
      View QPU Diagnostics <span class="material-symbols-outlined text-xs">arrow_forward</span>
    </a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 pt-3">
    <div>
      <div class="text-[10px] uppercase tracking-wider font-semibold text-tertiary">BACKEND / QPU</div>
      <div id="ibm-val-backend" class="text-base font-bold text-primary mt-0.5">ibm_fez (156Q)</div>
      <div id="ibm-val-proc" class="text-[11px] text-on-surface-variant truncate">Heron r2 Transmon</div>
    </div>
    <div>
      <div class="text-[10px] uppercase tracking-wider font-semibold text-tertiary">MEDIAN COHERENCE (T₁)</div>
      <div id="ibm-val-t1" class="text-base font-bold text-on-surface mt-0.5">133.14 µs</div>
      <div class="text-[11px] text-on-surface-variant">Relaxation time</div>
    </div>
    <div>
      <div class="text-[10px] uppercase tracking-wider font-semibold text-tertiary">MEDIAN DEPHASING (T₂)</div>
      <div id="ibm-val-t2" class="text-base font-bold text-on-surface mt-0.5">99.14 µs</div>
      <div class="text-[11px] text-on-surface-variant">Dephasing time</div>
    </div>
    <div>
      <div class="text-[10px] uppercase tracking-wider font-semibold text-tertiary">2-QUBIT CZ ERROR</div>
      <div id="ibm-val-cz" class="text-base font-bold text-on-surface mt-0.5">0.289%</div>
      <div class="text-[11px] text-on-surface-variant">Median gate error</div>
    </div>
    <div>
      <div class="text-[10px] uppercase tracking-wider font-semibold text-tertiary">QUEUE / STATUS</div>
      <div id="ibm-val-status" class="text-base font-bold text-success mt-0.5">Active (5 jobs)</div>
      <div class="text-[11px] text-on-surface-variant">Operational</div>
    </div>
  </div>
</div>

<div class="flex flex-wrap gap-3 pt-2">
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-semibold shadow-sm transition-all" href="/predict">
<span class="material-symbols-outlined text-base">biotech</span> Run a Live Prediction
</a>
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-primary/40 bg-primary/10 hover:bg-primary/20 text-primary font-semibold shadow-sm transition-all" href="/train">
<span class="material-symbols-outlined text-base">model_training</span> 🚀 Upload & Train (Deliverable 5)
</a>
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-secondary hover:bg-secondary-container text-on-secondary font-semibold shadow-sm transition-all" href="/walkthrough">
<span class="material-symbols-outlined text-base">fact_check</span> 📋 Judge Report (60s Skim)
</a>
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container text-on-surface font-semibold transition-all" href="/architecture">
<span class="material-symbols-outlined text-base">gallery_thumbnail</span> Research Gallery
</a>
<a class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-outline-variant bg-surface-container-lowest hover:bg-surface-container text-on-surface font-semibold transition-all" href="/docs" target="_blank">
<span class="material-symbols-outlined text-base">api</span> API Documentation
</a>
</div>
</div>
</section>

<section class="space-y-4">
<h2 class="text-2xl font-bold tracking-tight">Explore the Platform</h2>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

<a href="/train" class="rounded-xl border border-primary/40 bg-primary/5 p-5 shadow-sm hover:shadow-md hover:border-primary transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">model_training</span>
<div class="text-base font-bold text-primary mt-2">🚀 Live Upload & Train</div>
<p class="text-sm text-on-surface-variant mt-1">Upload custom CSV, trigger live fast-fit training of Control A & B, and evaluate on held-out test data (Deliverable 5).</p>
</a>

<a href="/architecture" class="rounded-xl border border-primary/30 bg-primary/5 p-5 shadow-sm hover:shadow-md hover:border-primary transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">gallery_thumbnail</span>
<div class="text-base font-bold text-primary mt-2">🔬 Research Gallery</div>
<p class="text-sm text-on-surface-variant mt-1">Scroll-driven showcase of 14 multi-angle empirical findings, publication figures, and competitive positioning.</p>
</a>

<a href="/walkthrough" class="rounded-xl border border-secondary/40 bg-secondary/5 p-5 shadow-sm hover:shadow-md hover:border-secondary transition-all block">
<span class="material-symbols-outlined text-secondary text-2xl">fact_check</span>
<div class="text-base font-bold text-secondary mt-2">📋 Judge Report</div>
<p class="text-sm text-on-surface-variant mt-1">Single-page print-friendly compliance audit, 6-dataset summary, and honest limitations.</p>
</a>

<a href="/predict" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">bolt</span>
<div class="text-base font-bold mt-2">Predict</div>
<p class="text-sm text-on-surface-variant mt-1">Run a real WDBC record through the live Control A model.</p>
</a>
<a href="/uncertainty" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">blur_on</span>
<div class="text-base font-bold mt-2">Uncertainty Quantification</div>
<p class="text-sm text-on-surface-variant mt-1">30 finite-shot inference runs; genuine quantum measurement uncertainty.</p>
</a>
<a href="/compare" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">balance</span>
<div class="text-base font-bold mt-2">Quantum vs. Classical</div>
<p class="text-sm text-on-surface-variant mt-1">Live head-to-head on any of 114 real locked test-set patients.</p>
</a>
<a href="/explain" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">troubleshoot</span>
<div class="text-base font-bold mt-2">Explainability</div>
<p class="text-sm text-on-surface-variant mt-1">Integrated Gradients feature attribution with a completeness check.</p>
</a>
<a href="/batch" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">upload_file</span>
<div class="text-base font-bold mt-2">Batch Screening</div>
<p class="text-sm text-on-surface-variant mt-1">Upload a CSV, get live predictions across a whole cohort.</p>
</a>
<a href="/evaluation" class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm hover:shadow-md hover:border-primary/40 transition-all block">
<span class="material-symbols-outlined text-primary text-2xl">monitoring</span>
<div class="text-base font-bold mt-2">Evaluation Results</div>
<p class="text-sm text-on-surface-variant mt-1">Real accuracy/AUC/sensitivity/specificity across all 6 datasets.</p>
</a>
</div>
</section>

<section class="space-y-4">
<h2 class="text-2xl font-bold tracking-tight">Where the Quantum Architecture Genuinely Helps</h2>
<p class="text-on-surface-variant text-sm max-w-3xl">Not raw accuracy — that's parity, shown on the <a href="/evaluation" class="text-primary underline">Evaluation Results</a> page. These are the real, measurable engineering properties this architecture has because it's quantum.</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
<div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
<span class="material-symbols-outlined text-primary text-2xl">hub</span>
<div class="text-base font-bold mt-2">Federated Learning at ~292 Bytes/Round</div>
<p class="text-sm text-on-surface-variant mt-1">73 parameters × 4 bytes means a 4-hospital FedAvg simulation transmits ~292 bytes per round — over 2,000× lighter than a comparable classical clinical MLP. Labeled explicitly as a feasibility simulation, not a real deployment.</p>
</div>
<div class="rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-sm">
<span class="material-symbols-outlined text-primary text-2xl">blur_on</span>
<div class="text-base font-bold mt-2">Measurement-Based Uncertainty</div>
<p class="text-sm text-on-surface-variant mt-1">30 runs through a finite-shots device (1024 shots) yield a genuine empirical distribution per patient. Real shot noise, not a simulated confidence score — see the <a href="/uncertainty" class="text-primary underline">live demo</a>.</p>
</div>
</div>
</section>

</main>
<footer class="bg-surface-container-lowest border-t border-outline-variant mt-auto">
<div class="w-full py-5 px-4 sm:px-8 max-w-[1400px] mx-auto text-sm text-on-surface-variant text-center sm:text-left">
© 2026 QureML — Smart India Hackathon 2026, Problem Statement SIH26139. Sponsor: Egreen Quanta. Department of Computer Engineering, SPIT Mumbai.
</div>
</footer>
<script src="/nav.js"></script>


<script>
  // Dynamic Disease Modalities Benchmark Explorer
  const MODALITIES = {
    'breast': { name: 'Breast WDBC', metric: '100.0% Sensitivity', qAdv: '+4.8% ROC-AUC', fn: '0 False Negatives', n: '569 Patients' },
    'heart': { name: 'Heart Disease', metric: '91.8% Sensitivity', qAdv: '+1.8% Accuracy', fn: '1 Borderline Case', n: '297 Patients' },
    'parkinsons': { name: 'Parkinson Dysphonia', metric: '93.4% Sensitivity', qAdv: '+2.17% Confirmatory (p=0.0005)', fn: '0 False Negatives', n: '195 Patients' },
    'liver': { name: 'Liver ILPD', metric: '88.6% Sensitivity', qAdv: '+2.26% Margin (p=0.0039)', fn: '2 Outliers Flagged', n: '579 Patients' },
    'kidney': { name: 'Kidney CKD (Ablated)', metric: '97.2% Sensitivity', qAdv: 'Parity with MLP (p=0.082)', fn: '0 False Negatives', n: '158 Patients' }
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Navigation to Triage
    Array.from(document.querySelectorAll('button')).forEach(b => {
      const txt = b.textContent || '';
      if (txt.includes('Launch Batch') || txt.includes('Calibrate Tau')) {
        b.addEventListener('click', () => {
          window.location.href = '/predict';
        });
      }
    });

    // Live IBM Quantum Hardware Telemetry Fetch
    async function loadIbmTelemetry() {
      try {
        const res = await fetch('/ibm-live-telemetry');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        const badge = document.getElementById('ibm-status-badge');
        const badgeText = document.getElementById('ibm-status-text');
        if (data.live_connection_verified && data.operational) {
          badgeText.textContent = 'LIVE TELEMETRY';
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-success-container text-success border border-success/30';
        } else {
          badgeText.textContent = 'CACHED TELEMETRY';
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300';
        }
        if (data.backend_name) {
          document.getElementById('ibm-val-backend').textContent = `${data.backend_name} (${data.num_qubits || 156}Q)`;
        }
        if (data.processor_type) {
          document.getElementById('ibm-val-proc').textContent = data.processor_type.split('(')[0].trim();
        }
        if (data.live_calibration_metrics?.t1_us?.median) {
          document.getElementById('ibm-val-t1').textContent = `${data.live_calibration_metrics.t1_us.median.toFixed(2)} µs`;
        }
        if (data.live_calibration_metrics?.t2_us?.median) {
          document.getElementById('ibm-val-t2').textContent = `${data.live_calibration_metrics.t2_us.median.toFixed(2)} µs`;
        }
        if (data.live_calibration_metrics?.two_qubit_cz_error?.median) {
          document.getElementById('ibm-val-cz').textContent = `${(data.live_calibration_metrics.two_qubit_cz_error.median * 100).toFixed(3)}%`;
        }
        if (data.status_msg) {
          const pending = data.pending_jobs !== undefined ? ` (${data.pending_jobs} jobs)` : '';
          document.getElementById('ibm-val-status').textContent = `${data.status_msg.charAt(0).toUpperCase() + data.status_msg.slice(1)}${pending}`;
        }
      } catch (err) {
        console.warn('Could not refresh IBM live telemetry, showing cached values', err);
      }
    }
    loadIbmTelemetry();
  });
</script>

</body></html>
